# Node server
PORT=8080
NODE_ENV=production
ALLOWED_ORIGIN=https://YOUR-USERNAME.github.io

# Telegram WebApp bot token used to validate Telegram initData
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Firebase Admin service-account JSON as one line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}

# Long random secret used only by admin.html
ADMIN_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Optional comma-separated admin usernames for future policy checks
ADMIN_USERS=
